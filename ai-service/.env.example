# ==============================================================================
# Nexus AI/ML Service Environment Configuration
# ==============================================================================
# Service binding
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# CORS Origins allowed to communicate with this AI service (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security / Verification Note:
# No paid external API keys are required (TF-IDF & Scikit-learn run locally).
# Nexus platform RLS & authorization is maintained by the primary Next.js backend.
AI_SERVICE_NAME=nexus-ai-service
AI_SERVICE_VERSION=1.0.0

